service vendor.wifi_hal_legacy /vendor/bin/hw/android.hardware.wifi@1.0-service
    interface android.hardware.wifi@1.0::IWifi default
    interface android.hardware.wifi@1.1::IWifi default
    interface android.hardware.wifi@1.2::IWifi default
    interface android.hardware.wifi@1.3::IWifi default
    interface android.hardware.wifi@1.4::IWifi default
    class hal
    # IWifi@1.4 is not declared in the VINTF manifest -> registerAsService()
    # fails with UNKNOWN_ERROR and the service crash-loops. On Android 14
    # no client consumes the HIDL IWifi (WiFi runs via ISehWifi +
    # wpa_supplicant/AIDL). disabled prevents autostart; can still be
    # started manually if needed.
    disabled
    capabilities NET_ADMIN NET_RAW SYS_MODULE
    user wifi
    group wifi gps
